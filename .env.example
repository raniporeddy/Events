# CampusConnect Server Configuration
PORT=3000

# SMTP Email Configuration (Nodemailer)
# If left blank or unconfigured, CampusConnect runs in Development Mode (OTP logged to console/dev preview)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-university-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="CampusConnect System" <noreply@campusconnect.edu>
